{
  "$schema": "https://opencode.ai/config.json",
  // pi-agent-chat 智能体配置
  // 所有子智能体强制使用智谱 GLM-4.7

  "agent": {
    // === 内置子智能体 ===
    "explore": { "model": "zhipuai-coding-plan/glm-4.7" },
    "general": { "model": "zhipuai-coding-plan/glm-4.7" },
    "docs": { "model": "zhipuai-coding-plan/glm-4.7" },
    "spec": { "model": "zhipuai-coding-plan/glm-4.7" },
    "translator": { "model": "zhipuai-coding-plan/glm-4.7" },
    "ui-tester": { "model": "zhipuai-coding-plan/glm-4.7" },
    "ui-debugger": { "model": "zhipuai-coding-plan/glm-4.7" },
    "browser-harvester": { "model": "zhipuai-coding-plan/glm-4.7" },
    "form-filler": { "model": "zhipuai-coding-plan/glm-4.7" },
    "api-monitor": { "model": "zhipuai-coding-plan/glm-4.7" },
    "harness-factory": { "model": "zhipuai-coding-plan/glm-4.7" },
    "opencode-expert": { "model": "zhipuai-coding-plan/glm-4.7" },

    // === 项目自定义子智能体 ===
    "state-auditor": { "model": "zhipuai-coding-plan/glm-4.7" },
    "pi-dev": { "model": "zhipuai-coding-plan/glm-4.7" },
    "pi-debug": { "model": "zhipuai-coding-plan/glm-4.7" },
    "lsp-doctor": { "model": "zhipuai-coding-plan/glm-4.7" }
  },

  // 外部目录访问权限：无条件允许访问 pi-momo-fork
  "permission": {
    "external_directory": {
      "/Users/xuyingzhou/Project/temporary/pi-momo-fork/**": "allow"
    }
  }
}
