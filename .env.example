# 服务端口
PORT=3100

# 认证 Token（必填）
AUTH_TOKEN=demo-test-token

# 最大上传大小（字节）
MAX_UPLOAD_SIZE=52428800

# 通过公网反向代理访问 Vite dev 页面时设置，避免动态 import / HMR 暴露 localhost:5173
# VITE_PUBLIC_ORIGIN=https://your-public-dev-domain.example.com

# 日志目录
LOG_DIR=logs

# Agent CLI 路径（必填）
PI_CLI_PATH=

# 扩展路径说明：
# 扩展从全局目录 ~/.pi/agent/extensions/ 自动发现。
# 将扩展目录（含 index.ts）软链到该目录即可，无需逐个配置环境变量。
# 例如：
#   ln -s /path/to/pi-mono-fork/packages/coding-agent/extensions/auto-memory ~/.pi/agent/extensions/auto-memory

# 本地预览公网代理（可选）
# PROXY_API_URL=http://192.168.0.29:9080/__api__/register
# PROXY_PUBLIC_DOMAIN=shanbox.19930810.xyz:8443
