# 服务端口
PORT=3100

# 认证 Token（必填）
AUTH_TOKEN=demo-test-token

# 最大上传大小（字节）
MAX_UPLOAD_SIZE=52428800

# 日志目录
LOG_DIR=logs

# Agent CLI 路径（必填）
PI_CLI_PATH=

# Agent 扩展路径（可选，留空则不加载）
PI_EXT_SUBAGENT=
PI_EXT_TODO=
PI_EXT_BASH=
PI_EXT_LSP=
PI_EXT_PREVIEW=
PI_EXT_AUTO_MEMORY=
PI_EXT_RULES=
PI_EXT_AUTO_SESSION_TITLE=
PI_EXT_FILE_SNAPSHOT=
PI_EXT_ASK_TOOLS=
PI_EXT_MESSAGE_BRIDGE=
PI_EXT_COORDINATOR=
