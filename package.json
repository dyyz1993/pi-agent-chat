{
  "name": "pi-agent-chat",
  "version": "1.0.0",
  "description": "AI Agent Chat - A full-stack AI coding assistant with desktop and web support",
  "author": "",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyyz1993/pi-agent-chat"
  },
  "bugs": {
    "url": "https://github.com/dyyz1993/pi-agent-chat/issues"
  },
  "homepage": "https://github.com/dyyz1993/pi-agent-chat#readme",
  "keywords": [
    "ai",
    "agent",
    "chat",
    "coding",
    "electrobun",
    "react",
    "typescript"
  ],
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:web": "dotenv -e .env -- concurrently \"bun run hmr\" \"dotenv -e .env -- bun src/server.ts\"",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build": "vite build",
    "build:canary": "vite build && electrobun build --env=canary",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "lint:full": "bun run lint && bun run format:check",
    "prepare": "husky",
    "postinstall": "patch-package",
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch"
  },
  "dependencies": {
    "@dyyz1993/pi-agent-core": "^0.74.12",
    "@dyyz1993/pi-ai": "^0.74.8",
    "@dyyz1993/pi-coding-agent": "0.74.23",
    "@dyyz1993/pi-tui": "^0.74.8",
    "@dyyz1993/rpc-core": "^1.3.0",
    "@tanstack/react-virtual": "^3.13.24",
    "dotenv-cli": "^11.0.0",
    "electrobun": "1.13.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "virtua": "^0.49.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0",
    "ws": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
