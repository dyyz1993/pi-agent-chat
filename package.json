{
  "name": "pi-agent-chat",
  "version": "1.0.0",
  "description": "AI Agent Chat - A full-stack AI coding assistant with desktop and web support",
  "author": "",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyyz1993/pi-agent-chat"
  },
  "bugs": {
    "url": "https://github.com/dyyz1993/pi-agent-chat/issues"
  },
  "homepage": "https://github.com/dyyz1993/pi-agent-chat#readme",
  "keywords": [
    "ai",
    "agent",
    "chat",
    "coding",
    "electrobun",
    "react",
    "typescript"
  ],
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:desktop:native": "PI_ELECTROBUN_RENDERER=native electrobun dev --watch",
    "dev:web": "dotenv -e .env -- concurrently \"bun run hmr\" \"dotenv -e .env -- bun src/server.ts\"",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build": "vite build",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:desktop": "vite build && electrobun build",
    "build:desktop:native": "PI_ELECTROBUN_RENDERER=native vite build && PI_ELECTROBUN_RENDERER=native electrobun build",
    "lint": "eslint .",
    "lint:persistence": "bun scripts/lint-persistence-paths.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "lint:full": "bun run lint && bun run format:check",
    "prepare": "husky",
    "postinstall": "",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:smoke": "bash run-tests.sh smoke",
    "test:unit": "bash run-tests.sh run unit",
    "test:integration": "bash run-tests.sh run integration",
    "test:regression": "bash run-tests.sh run regression",
    "test:e2e-llm": "vitest run --config vitest.config.e2e.ts",
    "test:ui": "bash run-tests.sh run ui",
    "test:chat": "bash run-tests.sh run chat",
    "test:bash": "bash run-tests.sh run bash",
    "test:session": "bash run-tests.sh run session",
    "test:agent": "bash run-tests.sh run agent",
    "test:coordinator": "bash run-tests.sh run coordinator",
    "test:rollback": "bash run-tests.sh run rollback",
    "test:process-manager": "bash run-tests.sh run process-manager",
    "test:compaction": "bash run-tests.sh run compaction",
    "test:git": "bash run-tests.sh run git",
    "test:memory": "bash run-tests.sh run memory",
    "test:theme": "bash run-tests.sh run theme",
    "test:settings": "bash run-tests.sh run settings",
    "test:list": "bash run-tests.sh list",
    "verify:remote-child": "bun tools/verify-remote-child-runtime.ts",
    "verify:remote-bootstrap": "vitest run --config vitest.config.ts test/unit/scripts/remote-bootstrap.test.ts",
    "verify:worktree-stack": "bun tools/verify-worktree-stack-orchestration.ts",
    "test:failed": "bash run-tests.sh failed"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "@dyyz1993/pi-agent-core": "^0.78.3",
    "@dyyz1993/pi-ai": "^0.78.2",
    "@dyyz1993/pi-coding-agent": "file:.yalc/@dyyz1993/pi-coding-agent",
    "@dyyz1993/rpc-core": "^2.2.0",
    "diff": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "electrobun": "1.13.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "virtua": "^0.49.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.13",
    "@types/diff": "^8.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "streamdown": "2.5.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@dyyz1993/pi-agent-core": "0.78.3"
  }
}
