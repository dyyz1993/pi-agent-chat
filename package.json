{
	"name": "pi-agent-chat-app",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:web": "concurrently \"bun run hmr\" \"bun src/server.ts\"",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "husky",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@dyyz1993/pi-agent-core": "^0.69.18",
		"@dyyz1993/pi-ai": "^0.69.14",
		"@dyyz1993/pi-coding-agent": "^0.69.25",
		"@dyyz1993/rpc-core": "^1.0.3",
		"@tanstack/react-virtual": "^3.13.24",
		"electrobun": "1.13.1",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"lucide-react": "^1.8.0",
		"mermaid": "^11.14.0",
		"prism-react-renderer": "^2.4.1",
		"react": "^18.3.1",
		"react-diff-viewer-continued": "^4.2.2",
		"react-dom": "^18.3.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"vfile": "^6.0.3",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"eslint": "^9.0.0",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.0",
		"postcss": "^8.4.49",
		"sharp": "^0.34.5",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.0.3",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.1.5",
		"workbox-window": "^7.4.0",
		"ws": "^8.20.0"
	},
	"workspaces": [
		"packages/*"
	]
}
