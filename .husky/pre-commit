#!/bin/sh
bunx lint-staged

# Full ESLint check (catches cross-file issues like callChannel method name mismatches)
ESLINT_ERRORS=$(bun run lint 2>&1 | grep "error" | grep -v "warning" || true)
if [ -n "$ESLINT_ERRORS" ]; then
  echo "ESLint errors found:"
  echo "$ESLINT_ERRORS"
  exit 1
fi

# Type check (exclude sandbox and pi-momo-fork)
ERRORS=$(bunx tsc --noEmit 2>&1 | grep "error TS" | grep -v "node_modules" | grep -v "src/sandbox/" | grep -v "pi-momo-fork" || true)
if [ -n "$ERRORS" ]; then
  echo "$ERRORS"
  exit 1
fi
